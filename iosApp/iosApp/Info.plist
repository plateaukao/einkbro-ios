<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Web Archive</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.webarchive</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>EinkBro</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.5.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>info.plateaukao.einkbro.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>einkbro</string>
			</array>
		</dict>
		<!-- Required by Apple before the com.apple.developer.web-browser
		     entitlement request is reviewed: the request is validated against
		     the SHIPPING App Store binary's Info.plist, not against a promise
		     in the justification text. Inert until the entitlement is granted
		     (iOS ignores http/https claims from apps that don't hold it), but
		     it must already be in a released build at request time.
		     iOSApp.swift's onOpenURL -> handleExternalUrl already navigates
		     directly to the requested URL, which is the behavior Apple tests. -->
		<dict>
			<key>CFBundleURLName</key>
			<string>info.plateaukao.einkbro.ios.web</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>http</string>
				<string>https</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>12</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- EinkBro is a web browser: the user, not the app, chooses which
		     sites to visit, and plain-http sites must load (Android sets
		     usesCleartextTraffic=true + network_security_config.xml).
		     Scoped to web-view content only, so the app's own Ktor/NSURLSession
		     traffic (translate, OpenAI, Gemini, Edge-TTS) stays ATS-protected. -->
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>EinkBro shares links and app data with other EinkBro devices on your local network.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
